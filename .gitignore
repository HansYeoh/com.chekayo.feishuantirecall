# 构建产物
build/
*.apk
*.apk.idsig

# 签名私钥 —— 绝不入库（build.sh 会在缺失时自动生成本地 debug.keystore）
*.keystore
*.jks

# 逆向分析的目标二进制 / APK（版权 + 可能含账号数据）
*_base.apk
*.so
*.i64
*.id0
*.id1
*.id2
*.nam
*.til

# 抓取到的真实数据（花名册 / 个人资料 / 聊天导出）—— 绝不入库
roster*.json
*_roster*.json
profiles*.json
*_export*.json

# 运行期日志与缓存
*.log
__pycache__/
*.pyc

# 编辑器 / 工具
.claude/
.idea/
.vscode/

# 本地构建工具缓存(build.ps1 用, 勿提交)
tools/r8.jar
.zcodeignore

# 内部运维/取证工具 —— 只保留本地, 不入库(电报群值守 prompt 含内部流程/群ID, 水印工具公开即失效)
scripts/tg_watch_prompt.md
scripts/tg_poll.sh
scripts/tg_release.sh
scripts/wm_embed.py
scripts/wm_extract.py
tools/native-v163.apk

# 逆向分析工作区(目标 APK/dex/截图/LSPosed 库副本 —— 版权+隐私, 绝不入库)
tools/feishu8/
tools/lspd/
