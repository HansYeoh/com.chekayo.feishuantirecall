# 构建产物
build/
*.apk
*.apk.idsig

# 签名私钥 —— 绝不入库（build.sh 会在缺失时自动生成本地 debug.keystore）
*.keystore
*.jks

# 逆向分析的目标二进制 / APK（版权 + 可能含账号数据）
*_base.apk
*.so
*.i64
*.id0
*.id1
*.id2
*.nam
*.til

# 抓取到的真实数据（花名册 / 个人资料 / 聊天导出）—— 绝不入库
roster*.json
*_roster*.json
profiles*.json
*_export*.json

# 运行期日志与缓存
*.log
__pycache__/
*.pyc

# 编辑器 / 工具
.claude/
.idea/
.vscode/

# 本地构建工具缓存(build.ps1 用, 勿提交)
tools/r8.jar

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
